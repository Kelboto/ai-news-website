---
import { getBlogPosts } from "src/utils";
import BaseLayout from "$layouts/BaseLayout.astro";
import Header from "$components/Header.astro";
import Footer from "$components/Footer.astro";
import HeroStory from "$components/HeroStory.astro";
import TextStory from "$components/TextStory.astro";
import ImageStory from "$components/ImageStory.astro";
import StoryCluster from "$components/StoryCluster.astro";
import Sidebar from "$components/Sidebar.astro";
import SectionHeader from "$components/SectionHeader.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config.ts";

const allPosts = await getBlogPosts();

// Topic sections — Intercept/Tablet hybrid layout
const TOPICS = [
  { tag: "regulation", label: "Regulation" },
  { tag: "companies", label: "Companies" },
  { tag: "papers", label: "Papers" },
  { tag: "robotics", label: "Robotics" },
  { tag: "news", label: "News" },
];

const PER_SECTION = 4;

// Hero: most recent post
const hero = allPosts[0];

// Top Stories: 6 posts (excluding hero)
const topStories = allPosts.slice(1, 7);
const topStoriesLeft = topStories.slice(0, 3); // 3 text-only
const topStoriesRight = topStories.slice(3, 6); // 3 image cards

// Helper: build section cluster (1 featured + 3 secondary, excluding already-shown)
const excludeIds = new Set([
  hero?.id,
  ...topStories.map((p: any) => p.id),
]);

function clusterFor(tag: string) {
  const posts = allPosts
    .filter((p: any) => (p.data.tags ?? []).includes(tag) && !excludeIds.has(p.id))
    .slice(0, PER_SECTION);
  if (posts.length === 0) return null;
  return {
    featured: posts[0],
    secondary: posts.slice(1, 4),
  };
}

// Helper: pass post data with id as slug
function withSlug(post: any) {
  return { ...post.data, slug: post.id };
}
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Header active="blog" />
  <main class="max-w-7xl mx-auto mt-8 px-4 md:px-6">
    <header class="border-b-2 border-base-900 dark:border-base-100 pb-6 mb-10">
      <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-bold leading-none text-base-900 dark:text-base-50 mb-3">
        {SITE_TITLE}
      </h1>
      <p class="font-serif text-lg md:text-xl text-base-700 dark:text-base-300 leading-snug">
        Daily AI news — regulation, companies, papers, robotics, breakthroughs. Updated daily.
      </p>
    </header>

    {hero && <HeroStory {...withSlug(hero)} />}

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12">
      <div>
        {topStories.length > 0 && (
          <section class="mb-16">
            <SectionHeader label="Top Stories" slug="news" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div>
                {topStoriesLeft.map((post: any) => <TextStory {...withSlug(post)} />)}
              </div>
              <div class="space-y-6">
                {topStoriesRight.map((post: any) => <ImageStory {...withSlug(post)} />)}
              </div>
            </div>
          </section>
        )}

        {TOPICS.map(({ tag, label }) => {
          const cluster = clusterFor(tag);
          if (!cluster) return null;
          return (
            <StoryCluster
              label={label}
              slug={tag}
              featured={cluster.featured ? withSlug(cluster.featured) : null}
              secondary={cluster.secondary.map((p: any) => withSlug(p))}
            />
          );
        })}
      </div>

      <Sidebar />
    </div>
  </main>

  <Footer />
</BaseLayout>