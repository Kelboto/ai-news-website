---
import { BASE } from "../config.ts";
import FormattedDate from "./FormattedDate.astro";

const { title, description, pubDate, slug, tags, author } = Astro.props;

const primaryTag = tags?.[0];
---

<article class="group border-b border-base-200 dark:border-base-800 pb-5 mb-5 last:border-b-0 last:mb-0 last:pb-0">
  {primaryTag && (
    <a
      href={BASE + `/sections/${primaryTag}/`}
      class="inline-block text-[10px] font-bold uppercase tracking-widest text-accent-600 dark:text-accent-400 mb-2 hover:text-accent-700 dark:hover:text-accent-300 transition-colors"
    >
      {primaryTag}
    </a>
  )}
  <h3 class="font-serif text-xl md:text-2xl font-bold leading-tight text-base-900 dark:text-base-50 mb-2">
    <a href={BASE + `/posts/${slug}/`} class="hover:text-accent-700 dark:hover:text-accent-300 transition-colors">
      {title}
    </a>
  </h3>
  {description && (
    <p class="text-sm leading-snug text-base-700 dark:text-base-300 mb-2 line-clamp-3">
      {description}
    </p>
  )}
  <div class="flex items-center gap-x-2 text-xs text-base-600 dark:text-base-400">
    {author && <span class="font-semibold text-base-800 dark:text-base-200">{author}</span>}
    {author && pubDate && <span>·</span>}
    {pubDate && (
      <time datetime={pubDate}>
        <FormattedDate date={pubDate} />
      </time>
    )}
  </div>
</article>