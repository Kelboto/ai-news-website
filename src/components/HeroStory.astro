---
import { BASE, SHOW_IMAGES } from "../config.ts";
import FormattedDate from "./FormattedDate.astro";
import HeroImage from "./HeroImage.astro";

const { title, description, pubDate, slug, heroImage, tags, noImage, author } =
  Astro.props;

const primaryTag = tags?.[0];
---

<article class="group relative isolate border-b border-base-200 dark:border-base-800 pb-8 mb-12">
  {
    noImage || !SHOW_IMAGES || !heroImage ? null : (
      <a href={BASE + `/posts/${slug}/`} class="block mb-6 overflow-hidden">
        <div class="relative aspect-[16/9] w-full">
          <HeroImage image={heroImage} />
        </div>
      </a>
    )
  }
  <div class="max-w-4xl">
    {primaryTag && (
      <a
        href={BASE + `/sections/${primaryTag}/`}
        class="inline-block text-xs font-bold uppercase tracking-widest text-accent-600 dark:text-accent-400 mb-3 hover:text-accent-700 dark:hover:text-accent-300 transition-colors"
      >
        {primaryTag}
      </a>
    )}
    <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05] text-base-900 dark:text-base-50 mb-4">
      <a href={BASE + `/posts/${slug}/`} class="hover:text-accent-700 dark:hover:text-accent-300 transition-colors">
        {title}
      </a>
    </h1>
    {description && (
      <p class="font-serif text-lg md:text-xl leading-snug text-base-700 dark:text-base-300 mb-4 max-w-3xl">
        {description}
      </p>
    )}
    <div class="flex items-center gap-x-3 text-xs text-base-600 dark:text-base-400">
      {author && <span class="font-semibold text-base-900 dark:text-base-100">{author}</span>}
      {author && pubDate && <span>·</span>}
      {pubDate && (
        <time datetime={pubDate}>
          <FormattedDate date={pubDate} />
        </time>
      )}
    </div>
  </div>
</article>